@prefix : <http://example.com/company#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Company a owl:Class .

:Department a owl:Class .

:Employee a owl:Class .

:hasDepartment a owl:ObjectProperty ;
    rdfs:domain :Company ;
    rdfs:range :Department .

:hasEmployee a owl:ObjectProperty ;
    rdfs:domain :Department ;
    rdfs:range :Employee .

:reportsTo a owl:ObjectProperty ;
    rdfs:domain :Employee ;
    rdfs:range :Employee .

:worksIn a owl:ObjectProperty ;
    rdfs:domain :Employee ;
    rdfs:range :Department .

:companyName a owl:DatatypeProperty ;
    rdfs:domain :Company ;
    rdfs:range xsd:string .

:departmentName a owl:DatatypeProperty ;
    rdfs:domain :Department ;
    rdfs:range xsd:string .

:employeeId a owl:DatatypeProperty ;
    rdfs:domain :Employee ;
    rdfs:range xsd:string .

:employeeName a owl:DatatypeProperty ;
    rdfs:domain :Employee ;
    rdfs:range xsd:string .

:jobTitle a owl:DatatypeProperty ;
    rdfs:domain :Employee ;
    rdfs:range xsd:string .